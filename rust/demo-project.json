      { "paramId": "gain_db", "name": "Gain (dB)", "default": 0.0, "min": -60.0, "max": 24.0, "step": 0.1 }
    ] },
    { "id": "meter", "nodeType": "peak_rms_meter", "x": 420, "y": 260, "params": {}, "exposedParams": [] },
