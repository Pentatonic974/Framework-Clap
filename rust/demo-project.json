  ],
  "connections": [
    { "fromNode": "in", "fromPort": 0, "toNode": "g", "toPort": 0 },
    { "fromNode": "g", "fromPort": 0, "toNode": "out", "toPort": 0 },
    { "fromNode": "in", "fromPort": 1, "toNode": "out", "toPort": 1 },
    { "fromNode": "g", "fromPort": 0, "toNode": "meter", "toPort": 0 }
  ],
  "guiWidgets": [
    { "id": "w1", "widgetType": "knob", "label": "Gain (dB)", "paramId": "g/gain_db", "col": 0, "row": 0, "colSpan": 2, "rowSpan": 2 },
    { "id": "w2", "widgetType": "vu_meter", "label": "Out Level", "paramId": "meter", "col": 2, "row": 0, "colSpan": 1, "rowSpan": 2 }
  ]
