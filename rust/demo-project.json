{
  "meta": {
    "name": "DemoGain",
    "id": "com.claps.demo-gain",
    "version": "1.0.0",
    "vendor": "CLAP Studio",
    "url": "",
    "feature": "audio-effect"
  },
  "nodes": [
    { "id": "in", "nodeType": "clap_audio_in", "x": 40, "y": 120, "params": {}, "exposedParams": [] },
